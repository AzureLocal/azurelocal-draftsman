{
  "name": "azurelocal-draftsman",
  "private": false,
  "version": "0.3.0",
  "description": "Azure Local Draftsman: browser-based 2.5D cabling and compliance diagramming for Azure Local network architectures (pin-level cabling, VLANs, Network ATC intents, compliance auditor, cable schedule and switch port map export)",
  "keywords": [
    "azure-local",
    "draftsman",
    "cabling",
    "network-diagram",
    "compliance",
    "network-atc",
    "rack-aware",
    "isometric",
    "react"
  ],
  "homepage": "https://azurelocal.cloud/azurelocal-draftsman/",
  "bugs": {
    "url": "https://github.com/AzureLocal/azurelocal-draftsman/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AzureLocal/azurelocal-draftsman"
  },
  "author": "AzureLocal contributors (forked from AzLoFlows by Cristian Edwards Sabathe)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 70",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:build": "npm --prefix docs run docs:build",
    "build:site": "npm run build && npm run docs:build && node scripts/assemble-site.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.57.1",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  },
  "contributors": [
    {
      "name": "Cristian Edwards Sabathe",
      "description": "Author of AzLoFlows, the upstream project"
    }
  ]
}
